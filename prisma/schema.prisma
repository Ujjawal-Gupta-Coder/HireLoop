generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum CreditTransactionType {
  ADMIN
  REGISTRATION
  PURCHASE
  TECHNICAL_INTERVIEW
  CODING_INTERVIEW
  SYSTEM_DESIGN_INTERVIEW
  BEHAVIORAL_INTERVIEW
  MIXED_INTERVIEW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InterviewType {
  TECHNICAL_INTERVIEW
  CODING_INTERVIEW
  SYSTEM_DESIGN_INTERVIEW
  BEHAVIORAL_INTERVIEW
  MIXED_INTERVIEW
}

enum InterviewRole {
  FULL_STACK_DEVELOPER
  FRONT_END_DEVELOPER
  BACK_END_DEVELOPER
  REACT_DEVELOPER
  SOFTWARE_ENGINEER 
  MOBILE_APP_DEVELOPER
  DEVOPS_ENGINEER
  AI_ML_ENGINEER
}

enum Experience {
  FRESHER
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD_STAFF
  MANAGER
}

enum DifficultyType {
  EASY
  MEDIUM
  HARD
}

enum InterviewSessionType {
  QUICK
  STANDARD
  EXTENDED
}

enum InterviewStatus {
  RUNNING
  ABANDONED
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  credits   Int

  creditHistory CreditHistory[]
  payment Payment[]
  interviewHistory InterviewHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id String @id @default(cuid())
  name String @unique
  credits Int
  amount Int
  currencySymbol String
  description String?
  features String[]
  isMostPopular Boolean @default(false)
  buttonText String

  payment Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditHistory {
  id String @id @default(cuid())

  userId String
  credit Int

  type CreditTransactionType

  stripeSessionId String? @unique
  reason String

  user User @relation(fields: [userId], references: [id])
  payment Payment?

  createdAt DateTime @default(now()) 
}

model InterviewHistory {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id]) 

  type InterviewType
  role InterviewRole
  experience Experience
  difficulty DifficultyType
  skills String[] 
  sessionType InterviewSessionType
  context String? 

  creditsUsed Int
  totalQuestions Int
  answered Int 
  status InterviewStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())
  userId String
  planId String
  creditHistoryId String @unique

  amount Int
  currencyCode String
  status PaymentStatus

  sessionId String @unique
  receiptId String @unique
  receiptPath String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
  creditHistory CreditHistory @relation(fields: [creditHistoryId], references: [id])
}

model Testimonial {
  id String @id @default(cuid())
  quote String
  name String
  role String
  avatar String
  color String 
  order Int
  createdAt DateTime @default(now())
}

model FAQ {
  id String @id @default(cuid())
  question String
  answer String
  order Int
  createdAt DateTime @default(now())
}