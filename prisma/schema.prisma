generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum CreditTransactionType {
  REGISTRATION
  PURCHASE
  BASIC_INTERVIEW
  CODING_INTERVIEW
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  credits   Int

  creditHistory CreditHistory[]
  payment Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id String @id @default(cuid())
  name String @unique
  credits Int
  amount Int
  currencySymbol String
  description String?
  features String[]
  isMostPopular Boolean @default(false)
  buttonText String

  payment Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditHistory {
  id String @id @default(cuid())

  userId String
  credit Int

  type CreditTransactionType

  stripeSessionId String? @unique
  reason String

  user User @relation(fields: [userId], references: [id])
  payment Payment?

  createdAt DateTime @default(now()) 
}

model Payment {
  id String @id @default(cuid())
  userId String
  planId String
  creditHistoryId String @unique

  amount Int
  currencyCode String
  status PaymentStatus

  sessionId String @unique
  receiptId String @unique
  receiptPath String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
  creditHistory CreditHistory @relation(fields: [creditHistoryId], references: [id])
}